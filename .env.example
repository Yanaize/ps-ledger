# Server
PORT=3000
BIND_HOST=0.0.0.0
DB_PATH=./data/ps-price-compare.sqlite

# Cache TTLs (hours)
PRICE_TTL_HOURS=6
CATALOG_TTL_HOURS=24
GIFTCARD_TTL_HOURS=6
RATES_TTL_HOURS=12

# Minimum seconds between manual refresh requests per dataset
REFRESH_MIN_INTERVAL_SECONDS=300

# Auto-refresh when last success is older than this (hours). 12 = half a day.
AUTO_REFRESH_STALE_HOURS=12
# How often the server checks for stale data (minutes)
AUTO_REFRESH_CHECK_MINUTES=60

# Gift card providers
GIFTCARD_ENEBA_ENABLED=true

# Exchange rate providers (comma-separated, tried in order)
EXCHANGE_PROVIDERS=frankfurter,erapi

# PlayStation search: region used for initial search (IN recommended — English titles)
PS_SEARCH_REGION=IN

# Outbound HTTP
HTTP_USER_AGENT=ps-price-compare/1.0 (personal home LAN; +https://localhost)
HTTP_TIMEOUT_MS=20000
HTTP_MAX_CONCURRENCY=3

# Persisted GraphQL search hash (recapture from store.playstation.com DevTools if search breaks)
PS_SEARCH_HASH=4df6284f982e57bec70f23c77e2c219dc792eb19af7fb3d3a81767aa3f1958aa
